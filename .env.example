# RecoTrust V5.1 — variables d'environnement (production)
# Copier vers .env ou exporter dans le service systemd / conteneur.
# Ces variables sont déjà lues par le code (auth/users.py, auth/audit.py).

# Répertoire persistant des données utilisateurs (authorized_users.json)
# RECOTRUST_DATA_DIR=/var/lib/recotrust/data

# Répertoire des journaux d'audit
# RECOTRUST_LOG_DIR=/var/log/recotrust
