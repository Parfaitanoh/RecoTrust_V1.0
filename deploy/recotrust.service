# RecoTrust V5.1 — Unité systemd (exemple)
# Installation :
#   sudo cp deploy/recotrust.service /etc/systemd/system/recotrust.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now recotrust
#
# Adapter User, WorkingDirectory, et les chemins selon l'instance.

[Unit]
Description=RecoTrust V5.1 — Réconciliation Revenue Assurance (PayMeTrust)
After=network.target

[Service]
Type=simple
User=recotrust
Group=recotrust
WorkingDirectory=/opt/recotrust
Environment=RECOTRUST_DATA_DIR=/var/lib/recotrust/data
Environment=RECOTRUST_LOG_DIR=/var/log/recotrust
Environment=PATH=/opt/recotrust/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/recotrust/.venv/bin/streamlit run main.py --server.address 127.0.0.1 --server.port 8501 --server.headless true --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5
# Limites ressources (ajuster selon la machine et la charge)
MemoryMax=4G
CPUQuota=200%

# Sécurité processus
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
